<div style="height:400px; display:flex; flex-direction:column; justify-content:center; align-items:center;">

  <h1 class = "page-title">宿泊施設を検索</h1>

  <%= form_with url: rooms_path, method: :get do |f| %>
    <div>
      <%= f.text_field :area, placeholder: "東京・大阪・京都・札幌" %>
      <%= f.submit "検索" %>
    </div>
  <% end %>

</div>